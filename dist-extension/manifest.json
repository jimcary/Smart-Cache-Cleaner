{
  "manifest_version": 3,
  "name": "智能缓存清理 (Smart Cache Cleaner)",
  "version": "1.0.0",
  "description": "按会话间隔(默认30分钟)自动统计域名访问频次，并提供一键清理低频域名的缓存、Cookie与Storage功能。",
  "permissions": [
    "tabs",
    "storage",
    "browsingData",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "智能缓存清理",
    "default_icon": {
      "16": "assets/icon.jpg",
      "32": "assets/icon.jpg",
      "48": "assets/icon.jpg",
      "128": "assets/icon.jpg"
    }
  },
  "icons": {
    "16": "assets/icon.jpg",
    "32": "assets/icon.jpg",
    "48": "assets/icon.jpg",
    "128": "assets/icon.jpg"
  },
  "options_page": "options.html"
}